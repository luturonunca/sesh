#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

die() {
  echo "sesh: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  sesh <subcommand> [args]

Subcommands:
  z <output_dir>                  Redshift of a single snapshot (or 'all' for every output_* in cwd)
  time <output_dir>               Redshift, age, and lookback time (or 'all')
  eventstats <root> [--from N]    Count SF/SN/B-SF/B-SN2/B-MRG events (stars_*.out*) and sink births (sink_*.csv) per snapshot
  simstatus [--path DIR]          One-line status per simulation: latest snapshot, z, last write time
  sinkmass <sim_dir> <id> [--snap N]  msink and msmbh in solar masses for a sink ID (latest or snapshot N)
  walltime <sim_dir> [--to-z Z]   Cumulative wall time and CPU-Kh per output up to redshift Z
  report <sim_dir> [options]      Write per-snapshot CSV table (numpy-loadable)
    --fields f1,f2,...            Fields: z, t, lookback, nstars, sinkmass:N, smbhmass:N, accrate:N, rho:N
    --preset z_stars|cosmo|z_bh:N|sink_evol:N  Named field combination
    --out <file>                  Output file (default: sesh_report.csv)
    --from N                      Skip outputs before output_N

EOF
}

find_info_file() {
  local dir="$1"
  local -a files
  shopt -s nullglob
  files=("$dir"/info_*.txt)
  shopt -u nullglob
  (( ${#files[@]} )) || die "no info_*.txt found in $dir"
  printf '%s\n' "${files[0]}"
}

get_param() {
  local key="$1"
  local file="$2"
  awk -v k="$key" '
    BEGIN { FS="=" }
    $0 ~ "^[[:space:]]*"k"[[:space:]]*=" {
      val=$2
      gsub(/[[:space:]]/, "", val)
      print val
      exit
    }
  ' "$file"
}

require_param() {
  local key="$1"
  local file="$2"
  local val
  val=$(get_param "$key" "$file")
  [[ -n "$val" ]] || die "missing $key in $file"
  printf '%s\n' "$val"
}

cmd_z() {
  local outdir="$1"
  [[ -d "$outdir" ]] || die "not a directory: $outdir"
  local info
  info=$(find_info_file "$outdir")
  awk '
    /aexp/ { a=$3 }
    END {
      if (a<=0) exit 1
      printf "%.8f\n", (1.0/a)-1.0
    }
  ' "$info" || die "invalid aexp in $info"
}

cmd_z_all() {
  local -a outputs
  shopt -s nullglob
  outputs=(./output_*)
  shopt -u nullglob
  (( ${#outputs[@]} )) || die "no output_* directories found in ."
  printf "# %5s  ,  %7s\n" "output" "z"
  printf "# %5s  ,  %7s\n" "-----" "-------"
  local outdir outname nchar z
  for outdir in "${outputs[@]}"; do
    [[ -d "$outdir" ]] || continue
    outname=$(basename -- "$outdir")
    nchar="${outname#output_}"
    z=$(cmd_z "$outdir") || die "failed z for $outdir"
    printf "%5d  ,  %7.4f\n" "10#$nchar" "$z"
  done
}

cmd_time() {
  local outdir="$1"
  [[ -d "$outdir" ]] || die "not a directory: $outdir"
  local info
  info=$(find_info_file "$outdir")
  awk '
    function asinh(x) { return log(x + sqrt((x * x) + 1.0)) }
    /aexp/ { a=$3 }
    /H0/ { H0=$3 }
    /omega_m/ { Om=$3 }
    /omega_l/ { Ol=$3 }
    END {
      if (a<=0 || H0<=0 || Om<=0 || Ol<=0) exit 1
      z=1/a-1
      H0s=H0*1000/(3.085677581e22)
      tH=1/H0s/3.15576e16
      t=(2/(3*sqrt(Ol)))*asinh(sqrt(Ol/Om)*a^(3/2))*tH
      t0=(2/(3*sqrt(Ol)))*asinh(sqrt(Ol/Om))*tH
      printf "z=%.3f  t=%.3f Gyr  lookback=%.3f Gyr\n", z, t, t0-t
    }
  ' "$info" || die "cosmology calculation failed for $info"
}

cmd_time_all() {
  local -a outputs
  shopt -s nullglob
  outputs=(./output_*)
  shopt -u nullglob
  (( ${#outputs[@]} )) || die "no output_* directories found in ."
  printf "# %5s  ,  %7s  ,  %8s  ,  %8s\n" "output" "z" "t_Gyr" "lkbk_Gyr"
  printf "# %5s  ,  %7s  ,  %8s  ,  %8s\n" "-----" "-------" "--------" "--------"
  local outdir outname nchar info
  for outdir in "${outputs[@]}"; do
    [[ -d "$outdir" ]] || continue
    outname=$(basename -- "$outdir")
    nchar="${outname#output_}"
    info=$(find_info_file "$outdir") || continue
    awk -v nchar="$nchar" '
      function asinh(x) { return log(x + sqrt((x * x) + 1.0)) }
      /aexp/ { a=$3 } /H0/ { H0=$3 } /omega_m/ { Om=$3 } /omega_l/ { Ol=$3 }
      END {
        if (a<=0 || H0<=0 || Om<=0 || Ol<=0) exit 1
        z=1/a-1
        H0s=H0*1000/(3.085677581e22); tH=1/H0s/3.15576e16
        t=(2/(3*sqrt(Ol)))*asinh(sqrt(Ol/Om)*a^(3/2))*tH
        t0=(2/(3*sqrt(Ol)))*asinh(sqrt(Ol/Om))*tH
        printf "%5d  ,  %7.4f  ,  %8.4f  ,  %8.4f\n", nchar+0, z, t, t0-t
      }
    ' "$info" || die "cosmology calculation failed for $info"
  done
}

cmd_eventstats() {
  local root="$1"
  local start="${2:-}"
  [[ -d "$root" ]] || die "not a directory: $root"
  if [[ -n "$start" ]]; then
    [[ "$start" =~ ^[0-9]+$ ]] || die "start must be an integer: $start"
  fi
  local -a outputs
  shopt -s nullglob
  outputs=("$root"/output_*)
  shopt -u nullglob
  (( ${#outputs[@]} )) || die "no output_* directories found in $root"

  printf "# %5s  ,  %7s  ,  %6s  ,  %6s  ,  %6s  ,  %6s  ,  %6s  ,  %6s\n" \
    "output" "z" "SF" "SN" "B-SF" "B-SN2" "B-MRG" "Sinks"
  printf "# %5s  ,  %7s  ,  %6s  ,  %6s  ,  %6s  ,  %6s  ,  %6s  ,  %6s\n" \
    "-----" "-------" "------" "------" "------" "------" "------" "------"

  local use_color=0
  [[ -t 1 && -z "${NO_COLOR:-}" ]] && use_color=1

  local outdir outname nchar z sinkfile curr_ids born
  local prev_ids="" have_prev=0
  local -a files
  for outdir in "${outputs[@]}"; do
    [[ -d "$outdir" ]] || continue
    outname=$(basename -- "$outdir")
    nchar="${outname#output_}"
    if [[ -n "$start" ]]; then
      (( 10#$nchar < 10#$start )) && continue
    fi
    shopt -s nullglob
    files=("$outdir"/stars_*.out*)
    shopt -u nullglob
    (( ${#files[@]} )) || die "no stars_*.out* found in $outdir"
    z=$(cmd_z "$outdir") || die "failed z for $outdir"

    # Sink birth = ids present now but absent from the previous processed
    # snapshot. A raw nsink diff would undercount whenever a merger and a
    # formation land in the same interval, since ids are never reused
    # (monotonic nindsink counter in RAMSES) but merged sinks disappear.
    sinkfile="$outdir/sink_${nchar}.csv"
    if [[ -f "$sinkfile" ]]; then
      curr_ids=$(awk -F',' '/^#/ { next } { print $1+0 }' "$sinkfile")
      if (( have_prev )); then
        born=$(awk -v prev="$prev_ids" -v curr="$curr_ids" '
          BEGIN {
            n = split(prev, p, "\n")
            for (i = 1; i <= n; i++) if (p[i] != "") seen[p[i]] = 1
            m = split(curr, c, "\n")
            cnt = 0
            for (i = 1; i <= m; i++) if (c[i] != "" && !(c[i] in seen)) cnt++
            print cnt
          }')
      else
        born="NA"
      fi
      prev_ids="$curr_ids"
      have_prev=1
    else
      born="NA"
      prev_ids=""
      have_prev=0
    fi

    awk -v nchar="$nchar" -v z="$z" -v color="$use_color" -v born="$born" '
      $1==0 {c0++}
      $1==1 {c1++}
      $1==2 {c2++}
      $1==3 {c3++}
      $1==4 {c4++}
      function col(n,    s) {
        s = sprintf("%6d", n)
        if (color && n > 0) return sprintf("\033[36m%s\033[0m", s)
        return s
      }
      function colborn(v,    s) {
        if (v == "NA") return sprintf("%6s", "NA")
        s = sprintf("%6d", v+0)
        if (color && v+0 > 0) return sprintf("\033[36m%s\033[0m", s)
        return s
      }
      END {
        printf "%5d  ,  %7.4f  ,  %s  ,  %s  ,  %s  ,  %s  ,  %s  ,  %s\n",
          nchar+0, z+0, col(c0+0), col(c1+0), col(c2+0), col(c3+0), col(c4+0), colborn(born)
      }
    ' "${files[@]}"
  done
}

cmd_simstatus() {
  local root="${1:-.}"
  [[ -d "$root" ]] || die "not a directory: $root"

  local RED="" YELLOW="" BLUE="" CYAN="" GREEN="" BOLD="" RESET=""
  if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    RED=$'\e[31m'
    YELLOW=$'\e[33m'
    BLUE=$'\e[34m'
    CYAN=$'\e[36m'
    GREEN=$'\e[32m'
    BOLD=$'\e[1m'
    RESET=$'\e[0m'
  fi

  local HOUR=$((60*60))
  local DAY=$((24*HOUR))
  local WEEK=$((7*DAY))
  local MONTH=$((30*DAY))

  printf "%-13s %-63s %-12s %s\n" "snapshot" "simulation" "z_latest" "last_write"
  printf "%-13s %-63s %-12s %s\n" "-----------" "---------------------------------------------------------------" "----------" "----------------"

  local simdir simname
  local -a snaps
  for simdir in "$root"/*/; do
    [[ -d "$simdir" ]] || continue
    simname=$(basename -- "$simdir")

    shopt -s nullglob
    snaps=("$simdir"/output_?????)
    shopt -u nullglob
    (( ${#snaps[@]} )) || continue
    local latest
    latest=$(printf '%s\n' "${snaps[@]}" | sort -V | tail -n 1)

    local infofile
    infofile=$(ls -1t "$latest"/info_* 2>/dev/null | head -n 1)
    [[ -n "$infofile" ]] || continue

    local zfmt
    zfmt=$(awk '
      /aexp/ { a=$3 }
      END {
        if (a<=0) exit 1
        printf "%.3f", (1.0/a)-1.0
      }
    ' "$infofile") || continue

    local mtime_epoch now_epoch age stamp
    mtime_epoch=$(stat -c %Y "$infofile")
    now_epoch=$(date +%s)
    age=$(( now_epoch - mtime_epoch ))
    stamp=$(date -d @"$mtime_epoch" '+%Y-%m-%d %H:%M')

    local color tag
    if (( age > MONTH )); then color=$RED; tag=">1mo"
    elif (( age > WEEK )); then color=$YELLOW; tag=">1w"
    elif (( age > DAY )); then color=$BLUE; tag=">1d"
    elif (( age > HOUR )); then color=$CYAN; tag=">1h"
    else color=$GREEN; tag="~1h"
    fi

    printf "%-13s %-63s %-12s %s\n" "$(basename -- "$latest")" "$simname" "$zfmt" "${color}${stamp} (${tag})${RESET}"
  done
}

cmd_report() {
  local simdir="$1"
  shift
  [[ -d "$simdir" ]] || die "not a directory: $simdir"

  local fields="" outfile="sesh_report.csv" start="" preset=""
  while (( $# )); do
    case "$1" in
      --fields) fields="$2"; shift 2 ;;
      --preset) preset="$2"; shift 2 ;;
      --out)    outfile="$2"; shift 2 ;;
      --from)   start="$2"; shift 2 ;;
      *) die "report: unknown option: $1" ;;
    esac
  done

  if [[ -n "$preset" ]]; then
    [[ -z "$fields" ]] || die "report: --preset and --fields are mutually exclusive"
    case "$preset" in
      z_stars) fields="z,nstars" ;;
      cosmo)   fields="z,t,lookback" ;;
      z_bh:*)
        local bh_preset="${preset#z_bh:}"
        [[ "$bh_preset" =~ ^[0-9]+$ ]] || die "report: z_bh preset requires numeric id"
        fields="z,sinkmass:${bh_preset},smbhmass:${bh_preset}"
        ;;
      sink_evol:*)
        local sink_preset="${preset#sink_evol:}"
        [[ "$sink_preset" =~ ^[0-9]+$ ]] || die "report: sink_evol preset requires numeric id"
        fields="z,t,sinkmass:${sink_preset},accrate:${sink_preset}"
        ;;
      *) die "report: unknown preset '$preset' (known: z_stars, cosmo, z_bh:<id>, sink_evol:<id>)" ;;
    esac
  fi

  [[ -n "$fields" ]] || die "report: specify --fields or --preset"

  local -a field_arr
  IFS=',' read -ra field_arr <<< "$fields"

  local header="output"
  local f
  for f in "${field_arr[@]}"; do
    case "$f" in
      z)          header+=",z" ;;
      t)          header+=",t_Gyr" ;;
      lookback)   header+=",lookback_Gyr" ;;
      nstars)     header+=",nstars" ;;
      sinkmass:*) header+=",msink_${f#sinkmass:}_Msol" ;;
      smbhmass:*) header+=",msmbh_${f#smbhmass:}_Msol" ;;
      accrate:*)  header+=",accrate_${f#accrate:}_Msolyr" ;;
      rho:*)      header+=",rho_${f#rho:}_gcm3" ;;
      *) die "report: unknown field '$f'" ;;
    esac
  done

  local -a snaps
  shopt -s nullglob
  snaps=("$simdir"/output_?????)
  shopt -u nullglob
  (( ${#snaps[@]} )) || die "no output_* found in $simdir"

  {
    printf "# %s\n" "$header"
    local snap snapname num infofile val row bh_id nchar csvfile unit_l unit_d unit_t
    local -a sfiles ifiles
    for snap in $(printf '%s\n' "${snaps[@]}" | sort -V); do
      [[ -d "$snap" ]] || continue
      snapname=$(basename -- "$snap")
      num="${snapname#output_}"
      if [[ -n "$start" ]]; then
        (( 10#$num < 10#$start )) && continue
      fi
      shopt -s nullglob
      ifiles=("$snap"/info_*.txt)
      shopt -u nullglob
      (( ${#ifiles[@]} )) || continue
      infofile="${ifiles[0]}"

      row="$((10#$num))"
      for f in "${field_arr[@]}"; do
        case "$f" in
          z)
            val=$(awk '/aexp/ { a=$3 } END { if (a>0) printf "%.6f", (1.0/a)-1.0; else exit 1 }' "$infofile") || val="NA"
            ;;
          t)
            val=$(awk '
              function asinh(x) { return log(x + sqrt(x*x + 1.0)) }
              /aexp/ { a=$3 } /H0/ { H0=$3 } /omega_m/ { Om=$3 } /omega_l/ { Ol=$3 }
              END {
                if (a<=0||H0<=0||Om<=0||Ol<=0) exit 1
                H0s=H0*1000/(3.085677581e22); tH=1/H0s/3.15576e16
                printf "%.4f", (2/(3*sqrt(Ol)))*asinh(sqrt(Ol/Om)*a^(3/2))*tH
              }' "$infofile") || val="NA"
            ;;
          lookback)
            val=$(awk '
              function asinh(x) { return log(x + sqrt(x*x + 1.0)) }
              /aexp/ { a=$3 } /H0/ { H0=$3 } /omega_m/ { Om=$3 } /omega_l/ { Ol=$3 }
              END {
                if (a<=0||H0<=0||Om<=0||Ol<=0) exit 1
                H0s=H0*1000/(3.085677581e22); tH=1/H0s/3.15576e16
                t=(2/(3*sqrt(Ol)))*asinh(sqrt(Ol/Om)*a^(3/2))*tH
                t0=(2/(3*sqrt(Ol)))*asinh(sqrt(Ol/Om))*tH
                printf "%.4f", t0-t
              }' "$infofile") || val="NA"
            ;;
          nstars)
            shopt -s nullglob
            sfiles=("$snap"/stars_*.out*)
            shopt -u nullglob
            if (( ${#sfiles[@]} )); then
              val=$(awk 'END { print NR }' "${sfiles[@]}")
            else
              val="NA"
            fi
            ;;
          sinkmass:*)
            bh_id="${f#sinkmass:}"
            nchar="${snapname#output_}"
            csvfile="$snap/sink_${nchar}.csv"
            unit_l=$(get_param unit_l "$infofile")
            unit_d=$(get_param unit_d "$infofile")
            if [[ -f "$csvfile" && -n "$unit_l" && -n "$unit_d" ]]; then
              val=$(awk -F',' -v id="$bh_id" -v ul="$unit_l" -v ud="$unit_d" '
                /^#/ { next }
                $1+0==id+0 { printf "%.4e", ($2+0)*ud*ul^3/1.9885e33; found=1; exit }
                END { if (!found) print "NA" }
              ' "$csvfile")
            else
              val="NA"
            fi
            ;;
          smbhmass:*)
            bh_id="${f#smbhmass:}"
            nchar="${snapname#output_}"
            csvfile="$snap/sink_${nchar}.csv"
            unit_l=$(get_param unit_l "$infofile")
            unit_d=$(get_param unit_d "$infofile")
            if [[ -f "$csvfile" && -n "$unit_l" && -n "$unit_d" ]]; then
              val=$(awk -F',' -v id="$bh_id" -v ul="$unit_l" -v ud="$unit_d" '
                /^#/ { next }
                $1+0==id+0 { printf "%.4e", ($21+0)*ud*ul^3/1.9885e33; found=1; exit }
                END { if (!found) print "NA" }
              ' "$csvfile")
            else
              val="NA"
            fi
            ;;
          accrate:*)
            bh_id="${f#accrate:}"
            nchar="${snapname#output_}"
            csvfile="$snap/sink_${nchar}.csv"
            unit_l=$(get_param unit_l "$infofile")
            unit_d=$(get_param unit_d "$infofile")
            unit_t=$(get_param unit_t "$infofile")
            if [[ -f "$csvfile" && -n "$unit_l" && -n "$unit_d" && -n "$unit_t" ]]; then
              val=$(awk -F',' -v id="$bh_id" -v ul="$unit_l" -v ud="$unit_d" -v ut="$unit_t" '
                /^#/ { next }
                $1+0==id+0 { printf "%.4e", ($13+0)*ud*ul^3/ut*3.15576e7/1.9885e33; found=1; exit }
                END { if (!found) print "NA" }
              ' "$csvfile")
            else
              val="NA"
            fi
            ;;
          rho:*)
            bh_id="${f#rho:}"
            nchar="${snapname#output_}"
            csvfile="$snap/sink_${nchar}.csv"
            unit_d=$(get_param unit_d "$infofile")
            if [[ -f "$csvfile" && -n "$unit_d" ]]; then
              val=$(awk -F',' -v id="$bh_id" -v ud="$unit_d" '
                /^#/ { next }
                $1+0==id+0 { printf "%.4e", ($15+0)*ud; found=1; exit }
                END { if (!found) print "NA" }
              ' "$csvfile")
            else
              val="NA"
            fi
            ;;
        esac
        row+=",$val"
      done
      printf "%s\n" "$row"
    done
  } > "$outfile"
  echo "sesh: report written to $outfile"
}

cmd_sinkmass() {
  local simdir="$1"
  local bh_id="$2"
  local snap_id="${3:-}"
  [[ -d "$simdir" ]] || die "not a directory: $simdir"
  [[ -n "$bh_id" ]] || die "usage: sesh sinkmass <sim_dir> <id> [--snap N]"

  local latest
  if [[ -n "$snap_id" ]]; then
    latest="$simdir/output_$(printf '%05d' "$snap_id")"
    [[ -d "$latest" ]] || die "no such snapshot: $latest"
  else
    local -a snaps
    shopt -s nullglob
    snaps=("$simdir"/output_?????)
    shopt -u nullglob
    (( ${#snaps[@]} )) || die "no output_* found in $simdir"
    latest=$(printf '%s\n' "${snaps[@]}" | sort -V | tail -n 1)
  fi
  local nchar
  nchar=$(basename -- "$latest" | sed 's/output_//')

  local infofile="$latest/info_${nchar}.txt"
  [[ -f "$infofile" ]] || die "no info file: $infofile"
  local unit_l unit_d
  unit_l=$(get_param unit_l "$infofile")
  unit_d=$(get_param unit_d "$infofile")
  [[ -n "$unit_l" && -n "$unit_d" ]] || die "missing unit_l/unit_d in $infofile"

  local csvfile="$latest/sink_${nchar}.csv"
  [[ -f "$csvfile" ]] || die "no sink file: $csvfile"

  awk -F',' -v id="$bh_id" -v ul="$unit_l" -v ud="$unit_d" -v snap="$(basename -- "$latest")" '
    /^#/ { next }
    $1+0 == id+0 {
      scale_m = ud * ul^3 / 1.9885e33
      msink = $2  + 0
      msmbh = $21 + 0
      printf "BH %d  msink=%.4e Msol  msmbh=%.4e Msol  (%s)\n", id, msink*scale_m, msmbh*scale_m, snap
      found=1; exit
    }
    END { if (!found) printf "BH id %d not found in %s\n", id, FILENAME }
  ' "$csvfile"
}

cmd_walltime() {
  local simdir="$1"
  local to_z="${2:-}"
  [[ -d "$simdir" ]] || die "not a directory: $simdir"

  local -a snaps
  shopt -s nullglob
  snaps=("$simdir"/output_?????)
  shopt -u nullglob
  (( ${#snaps[@]} )) || die "no output_* found in $simdir"

  printf "# %5s  ,  %7s  ,  %7s  ,  %8s  ,  %5s  ,  %9s\n" \
    "output" "z" "step_h" "cumul_h" "ncpu" "cpu_kh"
  printf "# %5s  ,  %7s  ,  %7s  ,  %8s  ,  %5s  ,  %9s\n" \
    "-----" "-------" "-------" "--------" "-----" "---------"

  local cumul_s=0 prev_total=0 prev_nrestart="" cpu_kh_s=0 prev_ncpu=0
  local snap snapname nchar tfile infofile nmlfile z ncpu total_s step_s nrestart new_job
  for snap in $(printf '%s\n' "${snaps[@]}" | sort -V); do
    [[ -d "$snap" ]] || continue
    snapname=$(basename -- "$snap")
    nchar="${snapname#output_}"
    tfile="$snap/timer_${nchar}.txt"
    infofile="$snap/info_${nchar}.txt"
    nmlfile="$snap/namelist.txt"
    [[ -f "$tfile" && -f "$infofile" && -f "$nmlfile" ]] || continue

    z=$(awk '/aexp/ { a=$3 } END { if (a>0) printf "%.4f", (1.0/a)-1.0; else exit 1 }' \
        "$infofile") || continue

    if [[ -n "$to_z" ]]; then
      [[ $(awk -v z="$z" -v t="$to_z" 'BEGIN { print (z+0 >= t+0) }') == "1" ]] || break
    fi

    ncpu=$(get_param ncpu "$infofile")
    [[ -n "$ncpu" ]] || continue

    nrestart=$(get_param nrestart "$nmlfile")
    nrestart="${nrestart:-0}"

    total_s=$(awk '/TOTAL[[:space:]]*$/ { v=substr($0,1,12)+0; if(v>0){ print v; exit } }' "$tfile")
    [[ -n "$total_s" ]] || continue

    # Detect restart: nrestart changed since the previous output means a new job started.
    # Use total_s directly as the step (timer reset at job start); otherwise diff from prev.
    if [[ "$nrestart" != "$prev_nrestart" && -n "$prev_nrestart" ]]; then
      new_job=1
    else
      new_job=0
    fi

    step_s=$(awk -v cur="$total_s" -v prev="$prev_total" -v newjob="$new_job" \
      'BEGIN { printf "%.6f", (newjob || cur+0 <= prev+0) ? cur : cur-prev }')

    cumul_s=$(awk -v c="$cumul_s" -v s="$step_s" 'BEGIN { printf "%.6f", c+s }')
    cpu_kh_s=$(awk -v c="$cpu_kh_s" -v s="$step_s" -v n="$ncpu" \
      'BEGIN { printf "%.6f", c + s*n }')
    prev_total=$total_s
    prev_nrestart=$nrestart
    prev_ncpu=$ncpu

    awk -v nchar="$nchar" -v z="$z" -v step="$step_s" \
        -v cumul="$cumul_s" -v ncpu="$ncpu" -v cpu_kh_s="$cpu_kh_s" '
      BEGIN {
        step_h  = step  / 3600.0
        cumul_h = cumul / 3600.0
        cpu_kh  = cpu_kh_s / 3600.0 / 1000.0
        printf "%5d  ,  %7.4f  ,  %7.4f  ,  %8.4f  ,  %5d  ,  %9.4f\n",
          nchar+0, z+0, step_h, cumul_h, ncpu+0, cpu_kh
      }
    '
  done
}

main() {
  if (( $# < 1 )); then
    usage >&2
    exit 1
  fi

  local cmd="$1"
  local outdir="${2:-}"
  case "$cmd" in
    z)
      if [[ "$outdir" == "all" ]]; then cmd_z_all; else cmd_z "$outdir"; fi
      ;;
    time)
      if [[ "$outdir" == "all" ]]; then cmd_time_all; else cmd_time "$outdir"; fi
      ;;
    eventstats)
      local start=""
      if (( $# == 4 )) && [[ "$3" == "--from" ]]; then
        start="$4"
      elif (( $# > 2 )); then
        die "usage: sesh eventstats <outputs_root> [--from N]"
      fi
      cmd_eventstats "$outdir" "$start"
      ;;
    simstatus)
      local root="."
      if (( $# == 4 )) && [[ "$3" == "--path" ]]; then
        root="$4"
      elif (( $# > 2 )); then
        die "usage: sesh simstatus [--path DIR]"
      fi
      cmd_simstatus "$root"
      ;;
    sinkmass)
      [[ $# -ge 3 ]] || die "usage: sesh sinkmass <sim_dir> <id> [--snap N]"
      local snap_id=""
      if (( $# == 5 )) && [[ "$4" == "--snap" ]]; then
        snap_id="$5"
      elif (( $# > 3 )); then
        die "usage: sesh sinkmass <sim_dir> <id> [--snap N]"
      fi
      cmd_sinkmass "$2" "$3" "$snap_id"
      ;;
    walltime)
      [[ $# -ge 2 ]] || die "usage: sesh walltime <sim_dir> [--to-z Z]"
      local wt_to_z=""
      if (( $# == 4 )) && [[ "$3" == "--to-z" ]]; then
        wt_to_z="$4"
      elif (( $# > 2 )); then
        die "usage: sesh walltime <sim_dir> [--to-z Z]"
      fi
      cmd_walltime "$2" "$wt_to_z"
      ;;
    report)
      [[ $# -ge 2 ]] || die "usage: sesh report <sim_dir> [--fields f1,f2,...|--preset name] [--out file] [--from N]"
      cmd_report "$2" "${@:3}"
      ;;
    -h|--help) usage ;;
    *) die "unknown subcommand: $cmd" ;;
  esac
}

main "$@"
